# Copy to .env (never commit .env) or export these variables.

# Target repository that contains the .concord/ folder
CONCORD_REPO_PATH=../concord-test

# "slack", "teams" or "console" (console only prints alerts, useful for testing)
WEBHOOK_TYPE=console

# Incoming webhook URL (Slack) or Workflows webhook URL (Teams)
WEBHOOK_URL=

# Seconds between two polls
POLL_INTERVAL_SECONDS=5

# Minutes without a heartbeat before an agent is considered away (Concord default: 30)
AWAY_AFTER_MINUTES=30
